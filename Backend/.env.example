NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:19006
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=techfix
DB_USER=techfix_app
DB_PASSWORD=replace-with-a-local-mariadb-password
DB_SSL=false

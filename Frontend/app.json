{
  "expo": {
    "name": "TechFix",
    "slug": "techfix",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "techfix",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "TechFix necesita la cámara para documentar equipos y leer códigos QR."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TechFix usa tu ubicación únicamente para mostrar cómo llegar al local, si lo solicitás."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TechFix usa la biometría para desbloquear tu sesión local."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F766E"
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font"
    ],
    "android": {
      "package": "com.techfix.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F766E"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ecc70a38-1a94-4fe1-803a-10139dd2dd7b"
      }
    },
    "owner": "matiaspalomeques-team"
  }
}
